    "smoke:webhook-rc": "npx --yes tsx scripts/smoke-stripe-webhook-rc.ts",
    "smoke:webhook-confirm": "npx --yes tsx scripts/smoke-m402-webhook-confirm.ts",
    "verify:wave1": "npx --yes tsx scripts/wave1-verify.ts",
    "sql:wave1": "npx --yes tsx scripts/wave1-sql-proof.ts",
    "apply:wave1-migrations": "npx --yes tsx scripts/wave1-apply-migrations.ts",
    "validate:gating": "npx --yes tsx scripts/validate-feature-gating.ts",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#0F172A' --splashBackgroundColor '#0F172A'"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
