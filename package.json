{
  "name": "awarix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:bundle-secrets": "bash scripts/check-bundle-secrets.sh",
    "build:secure": "npm run build && npm run check:bundle-secrets",
    "health:check": "curl -sS http://localhost:3000/api/health | head -c 2000",
